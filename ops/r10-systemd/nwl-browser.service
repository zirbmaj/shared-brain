[Unit]
Description=NWL Browser Service — headless chromium for screenshots (port 3860)
Documentation=file:///srv/nwl/shared-brain/projects/homelab-service-architecture.md
After=docker.service tailscaled.service
Requires=docker.service
Wants=tailscaled.service
StartLimitBurst=3
StartLimitIntervalSec=600

[Service]
Type=oneshot
RemainAfterExit=yes
User=nwl-svc
Group=nwl-svc
WorkingDirectory=/srv/nwl/browser
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=90

# Tenant slice for cgroup resource limits
Slice=nwl.slice

# Failure policy: sandboxed container, restart on crash only
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
