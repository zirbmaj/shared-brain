[Unit]
Description=NWL Home Assistant — smart plug control, power monitoring (port 8123)
Documentation=file:///srv/nwl/shared-brain/projects/homelab-service-architecture.md
After=docker.service tailscaled.service
Requires=docker.service
Wants=tailscaled.service
StartLimitBurst=3
StartLimitIntervalSec=600

[Service]
Type=oneshot
RemainAfterExit=yes
User=nwl-svc
Group=nwl-svc
WorkingDirectory=/srv/nwl/homeassistant
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=120

# Tenant slice for cgroup resource limits
Slice=nwl.slice

# Failure policy: docker compose needs time, no urgency
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
